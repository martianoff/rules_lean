load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

bzl_library(
    name = "defs",
    srcs = [
        "defs.bzl",
        "extensions.bzl",
        "toolchain.bzl",
        "//lean/private:bzl_srcs",
    ],
    deps = [
        "@bazel_skylib//rules:build_test",
    ],
)

# API docs for the Bazel Central Registry (see .github/workflows/release_prep.sh).
starlark_doc_extract(
    name = "defs.doc_extract",
    src = "defs.bzl",
    deps = [":defs"],
)

starlark_doc_extract(
    name = "extensions.doc_extract",
    src = "extensions.bzl",
    deps = [":defs"],
)

starlark_doc_extract(
    name = "toolchain.doc_extract",
    src = "toolchain.bzl",
    deps = [":defs"],
)
