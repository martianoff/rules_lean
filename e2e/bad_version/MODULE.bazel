"""Must fail: asks for a Lean version rules_lean does not know.

CI builds this module and checks the error message.
"""

module(name = "rules_lean_e2e_bad_version")

bazel_dep(name = "rules_lean", version = "0.0.0")
local_path_override(
    module_name = "rules_lean",
    path = "../..",
)

lean = use_extension("@rules_lean//lean:extensions.bzl", "lean")
lean.toolchain(version = "v4.35.0")
