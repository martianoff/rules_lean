load("//lean:defs.bzl", "lean_library", "lean_proof_test", "lean_test")

# Several modules of one target importing each other (A <- B <- C, A <- C).
lean_library(
    name = "multi",
    srcs = [
        "Multi/A.lean",
        "Multi/B.lean",
        "Multi/C.lean",
    ],
)

lean_proof_test(
    name = "multi_proofs",
    deps = [":multi"],
)

lean_library(
    name = "main",
    srcs = ["Multi/Main.lean"],
    deps = [":multi"],
)

lean_test(
    name = "multi_test",
    deps = [":main"],
)
